# ==============================================================================
# Kinetic AI - Environment Variables for Vercel Deployment
# ==============================================================================

# 1. Supabase Backend & Realtime
# Obtain from your Supabase Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI Question Generation Provider (Supports GroqCloud or xAI Grok)
# Option A: Groq Cloud API Key (recommended for ultra-low latency - starts with gsk_...)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: xAI Grok API Key (starts with xai-...)
# Obtain from: https://console.x.ai/
XAI_API_KEY=xai_your_xai_api_key_here
